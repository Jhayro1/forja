server {
  listen 8080;
  server_tokens off;
  client_max_body_size 2m;

  location / {
    proxy_pass http://${FORJA_UPSTREAM};
    proxy_http_version 1.1;
    # Forja valida Host y Origin contra FORJA_URL_PUBLICA: se conserva el Host original.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # Eventos en vivo (SSE): sin búfer y con conexiones largas.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }
}

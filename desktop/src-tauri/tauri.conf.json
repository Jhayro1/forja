{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forja",
  "version": "../../package.json",
  "identifier": "dev.forja.escritorio",
  "build": {
    "frontendDist": "../../panel/dist-escritorio",
    "devUrl": "http://localhost:5174/escritorio.html",
    "beforeDevCommand": { "script": "npm run dev:escritorio", "cwd": "../../panel" },
    "beforeBuildCommand": { "script": "npm run build:escritorio", "cwd": "../../panel" }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Forja",
    "copyright": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Orquestador de agentes de código en tu PC",
    "longDescription": "Forja planea con modelos caros y programa en paralelo con modelos baratos (Claude y Codex), aislados en WSL. Todo corre en tu PC.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"], "displayLanguageSelector": false },
      "wix": { "language": "es-ES" }
    }
  }
}
